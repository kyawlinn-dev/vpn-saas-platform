# Production backend example for the DigitalOcean Droplet.
# Place real values on the Droplet only, usually at:
# /var/www/novanet/backend/.env.production
#
# PM2 sets NODE_ENV=production. The backend also remains compatible with
# /var/www/novanet/backend/.env while migration is in progress.

NODE_ENV=production
PORT=3000

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_DASHBOARD_URL=https://admin.your-domain.com
RESELLER_DASHBOARD_URL=https://reseller.your-domain.com
MINIAPP_URL=https://app.your-domain.com
TELEGRAM_MINIAPP_URL=https://app.your-domain.com
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com,https://reseller.your-domain.com,https://app.your-domain.com

WEBHOOK_BASE_URL=https://api.your-domain.com
# Public customer /k key links. Usually same as WEBHOOK_BASE_URL.
PUBLIC_SUBSCRIPTION_BASE_URL=https://api.your-domain.com

TELEGRAM_BOT_TOKEN=
BOT_TOKEN_ENCRYPTION_KEY=

DIGITALOCEAN_TOKEN=
DIGITALOCEAN_REGION=sgp1
DIGITALOCEAN_SIZE=s-1vcpu-1gb
DIGITALOCEAN_IMAGE=ubuntu-22-04-x64
DIGITALOCEAN_SSH_KEY_FINGERPRINT=
DO_AUTO_PROVISION_ENABLED=false

SERVER_BOOTSTRAP_SSH_USER=root
SERVER_BOOTSTRAP_PRIVATE_KEY_PATH=/root/.ssh/id_ed25519
SERVER_BOOTSTRAP_KNOWN_HOSTS_FILE=/root/.ssh/known_hosts
SERVER_BOOTSTRAP_TIMEOUT_MS=600000
SERVER_BOOTSTRAP_POLL_INTERVAL_MS=10000
SERVER_PROVISION_TIMEOUT_MINUTES=25

OUTLINE_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/OutlineFoundation/outline-apps/master/server_manager/install_scripts/install_server.sh
DEFAULT_SERVER_MAX_ACTIVE_KEYS=100
DEFAULT_TRIAL_RESELLER_ID=
