# Local development example.
# Copy to backend/.env for local work. Do not commit real .env files.

NODE_ENV=development
PORT=3000

# Use a local Supabase instance or a separate development Supabase project.
# Do not point day-to-day local development at production customer data.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local dashboard and Mini App origins.
ADMIN_DASHBOARD_URL=http://localhost:3001
RESELLER_DASHBOARD_URL=http://localhost:3002
MINIAPP_URL=http://localhost:5173
TELEGRAM_MINIAPP_URL=https://your-ngrok-domain.ngrok-free.app
# Change this after each Mini App release to force Telegram WebView cache refresh.
MINIAPP_RELEASE_VERSION=local-dev
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173

# Telegram webhooks require public HTTPS. Use ngrok or a similar tunnel locally.
WEBHOOK_BASE_URL=https://your-ngrok-domain.ngrok-free.app

# Legacy single-bot fallback only. Multi-tenant bots load encrypted tokens from DB.
TELEGRAM_BOT_TOKEN=

# 64 hex characters / 32 bytes. Generate a different key per environment.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_TOKEN_ENCRYPTION_KEY=

# DigitalOcean server provisioning. Leave empty unless testing provisioning locally.
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_REGION=sgp1
DIGITALOCEAN_SIZE=s-1vcpu-1gb
DIGITALOCEAN_IMAGE=ubuntu-22-04-x64
DIGITALOCEAN_SSH_KEY_FINGERPRINT=
DO_AUTO_PROVISION_ENABLED=false

# SSH key used by Outline provisioning and metrics.
SERVER_BOOTSTRAP_SSH_USER=root
SERVER_BOOTSTRAP_PRIVATE_KEY_PATH=
SERVER_BOOTSTRAP_KNOWN_HOSTS_FILE=
SERVER_BOOTSTRAP_TIMEOUT_MS=600000
SERVER_BOOTSTRAP_POLL_INTERVAL_MS=10000
SERVER_PROVISION_TIMEOUT_MINUTES=25

# Public customer /k key links. Falls back to WEBHOOK_BASE_URL when omitted.
PUBLIC_SUBSCRIPTION_BASE_URL=http://localhost:3000

# Outline and capacity defaults.
OUTLINE_INSTALL_SCRIPT_URL=https://raw.githubusercontent.com/OutlineFoundation/outline-apps/master/server_manager/install_scripts/install_server.sh
DEFAULT_SERVER_MAX_ACTIVE_KEYS=100
DEFAULT_TRIAL_RESELLER_ID=

# Backend health monitoring.
SERVER_HEALTH_CHECK_INTERVAL_MS=600000
SERVER_HEALTH_STALE_MS=900000
USAGE_SYNC_STALE_MS=7200000

# Outline API client timeout (ms). Applies to every request the backend makes
# to Outline management APIs — /server, /access-keys, /metrics/transfer, etc.
# Default 60s covers slow /metrics/transfer responses from busy servers over
# cross-region networks. Lower to 15s if you want faster failure detection
# and are running from the same datacenter as your Outline servers.
OUTLINE_API_TIMEOUT_MS=60000

# app_events retention (days). Minimum enforced server-side = 7.
APP_EVENTS_RETENTION_DAYS=90

# Sentry error reporting (optional; if unset, Sentry is a no-op).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Telegram operator alerts (optional; both must be set to enable).
# Create a separate bot via @BotFather just for alerts, then paste the token.
# Get your chat_id from @userinfobot in Telegram.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Axiom log shipping (optional; both must be set to enable structured log
# aggregation). Without these, pino still writes JSON to stdout — you just
# lose the searchable dashboard. Sign up at https://axiom.co (free tier is
# 500 GB/mo, 30 day retention). Create a dataset called `novanet-backend`
# and an ingest-only API token.
AXIOM_TOKEN=
AXIOM_DATASET=novanet-backend
