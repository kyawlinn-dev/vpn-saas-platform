# Local dashboard example.
# The dashboard should call the Express backend for app data.

VITE_API_BASE_URL=http://localhost:3000/api

# Only keep these if a frontend auth path still needs Supabase anon auth.
# Never use the service-role key in frontend code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error reporting (optional; if unset, Sentry is a no-op).
VITE_SENTRY_DSN=
