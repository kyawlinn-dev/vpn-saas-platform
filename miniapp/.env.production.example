# Production Mini App build example.
# The Mini App is served by Nginx from the DigitalOcean Droplet.
# Copy to miniapp/.env.production locally or place on the Droplet build source.

VITE_BACKEND_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=https://api.your-domain.com/api

# Fallback only. Real production slug comes from Telegram start_param.
VITE_MINIAPP_SLUG=demo
