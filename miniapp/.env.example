# Local Mini App example.
# Copy to miniapp/.env for local work. VITE_ values are baked into the build.

VITE_BACKEND_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api

# Local fallback only. Production resolves the slug at runtime from Telegram
# WebApp initDataUnsafe.start_param.
VITE_MINIAPP_SLUG=demo
