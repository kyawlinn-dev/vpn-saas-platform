# Base URL of the backend (no trailing slash, no /api)
# Dev:  http://localhost:3000  (via ngrok in dev)
# Prod: https://your-app.ondigitalocean.app
VITE_BACKEND_BASE_URL=https://your-ngrok-or-prod-domain.com
VITE_API_BASE_URL=https://your-ngrok-or-prod-domain.com/api

# Fallback slug for dev only — production reads start_param from Telegram at runtime
VITE_MINIAPP_SLUG=your-reseller-slug
